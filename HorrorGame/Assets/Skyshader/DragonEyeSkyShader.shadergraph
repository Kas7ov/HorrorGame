{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "89fdc4a3afd4434e8c91055d956ac9b1",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "DragonEyeHorizon (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -297,
            "y": 200,
            "width": 160,
            "height": 136
        }
    },
    "m_Slots": [
        {
            "m_Id": "d377937c6e6d4a0fa47407cfb4969f22"
        },
        {
            "m_Id": "b4f911e9370149ffaa8b6d39fa2653e5"
        },
        {
            "m_Id": "4a43ef20f7d34fc9b742ca2b3ef84c0c"
        }
    ],
    "synonyms": [
        "screen buffer"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "DragonEyeHorizon",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "Color = 0; Alpha = 0;\n    #ifndef SHADERGRAPH_PREVIEW\n        uint2 pixel = uint2(ScreenUV.xy * _ScreenSize.xy);\n        float depth = LoadCameraDepth(pixel);\n        // Only empty sky pixels. Trees, terrain and buildings occlude the eye.\n        #if UNITY_REVERSED_Z\n            if (depth > 0.000001) return;\n        #else\n            if (depth < 0.999999) return;\n        #endif\n        float3 farPosition = ComputeWorldSpacePosition(ScreenUV.xy,\n            UNITY_RAW_FAR_CLIP_VALUE == 0 ? 0.0001 : 0.9999, UNITY_MATRIX_I_VP);\n        float3 ray = -GetWorldSpaceNormalizeViewDir(farPosition);\n        float facing = dot(ray, _DragonEyeForward.xyz);\n        if (facing <= 0.05) return;\n        float2 p = float2(dot(ray, _DragonEyeRight.xyz), dot(ray, _DragonEyeUp.xyz))\n            / (facing * _DragonEyeShape.xy);\n        float2 uv = p * 0.5 + 0.5;\n        if (any(uv < 0) || any(uv > 1)) return;\n        float opening = saturate(_DragonEyeShape.z);\n        if (opening <= 0.0001) return;\n        float almond = pow(saturate(1 - p.x * p.x), 0.65);\n        float lidHeight = opening * almond;\n        float lid = 1 - smoothstep(lidHeight - 0.035, lidHeight + 0.035, abs(p.y));\n        float edge = 1 - smoothstep(1 - _DragonEyeLook.x, 1, length(p));\n        // Crop the photo's beige frame, then softly feather the silhouette.\n        float2 artworkUV = lerp(float2(0.045, 0.04), float2(0.955, 0.96), uv);\n        float3 eye = SAMPLE_TEXTURE2D_LOD(_DragonEyeTexture, sampler_DragonEyeTexture, artworkUV, 0).rgb;\n        float breath = 1 + 0.035 * sin(_DragonEyeLook.z * 1.7);\n        Color = eye * _DragonEyeTint.rgb * _DragonEyeLook.y * breath\n            * GetCurrentExposureMultiplier();\n        Alpha = saturate(lid * edge * _DragonEyeShape.w * smoothstep(0, 0.1, opening));\n        // Real HDRP fog and volumetric clouds also render on top of this pass.\n        Alpha *= smoothstep(-0.015, _DragonEyeLook.w, ray.y);\n    #endif"
}

